# Seva Setu — Environment variable template
# Copy this to .env and fill in real values for local development.
# For production, set these in docker-compose.yml or your cloud platform.
# DO NOT commit .env — it is listed in .gitignore.

# Flask session signing key — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_HEX

# Admin panel login credentials — change from defaults before going live
ADMIN_USERNAME=REPLACE_WITH_USERNAME
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
